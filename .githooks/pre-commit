#!/bin/sh
# コミット前の検査(CLAUDE.md §7)。有効化: git config core.hooksPath .githooks
# 1. data/ のステージは拒否(gitignore 解除の事故防止)。ファイル名は NUL 区切りで扱う(空白入りでも分裂しない)。
# 2. 秘密スキャン: ステージ済みファイルを引数で渡す(引数なしは何も検査しない)。
# 3. (第330) 記録してはいけない道筋(絶対パス・ユーザー名・サーバー名)の検査と、
#    環境変数 COMMIT_EXPECT に「入れるはずのファイルの一覧」があれば、ステージの中身と集合で突き合わせる
#    (第329 の事故=一覧の CRLF で git add が 1 本にしか効かず 4 commit が空だった、の再発防止)。
if git diff --cached --name-only --diff-filter=ACM -z | tr '\000' '\n' | grep -q '^data/'; then
  echo "pre-commit: data/ はコミット禁止"; exit 1
fi
n=$(git diff --cached --name-only --diff-filter=ACM -z | tr -cd '\000' | wc -c)
if [ "$n" -gt 0 ]; then
  git diff --cached --name-only --diff-filter=ACM -z | xargs -0 python tools/scan_secrets.py || exit 1
fi
if [ -n "$COMMIT_EXPECT" ]; then
  python tools/commit_check.py --expect "$COMMIT_EXPECT" || exit 1
else
  python tools/commit_check.py --paths-only || exit 1
fi
