{
 "schema": "night5070/experiments/1",
 "note": "回答 10-25 §6-0・§6-2 の夜の実験の定義。{{名}} は vars の値で埋める。vars の値が null の名は穴(親が R-C の答申の後に埋める)。OUT(小さな記録の置き場=docs/bench/night5070/<日>_<実験>)・DATA(大きな出力の置き場=data/night5070/<日>_<実験>=gitignore の中。テープ・状態・checkpoints JSON・ログ)・PYTHON・REPO・RUN_ID・ENDPOINTS・EXPERIMENT は night_run が実行時に埋める(vars に書かない)。estimated_minutes の null は空欄(R-C で埋める)。",
 "deadline_hours": 9.5,
 "deadline_note": "night_run の締め切りの既定。タスクから回すときは register_task が --deadline-hours(実行時間の上限 − 0.5)を渡す",
 "start_at": null,
 "start_at_note": "予定の開始の時刻 HH:MM(要約の終わりの時刻の表に使う。タスクからは register_task の --at が渡る)",
 "cost": {
  "yen_per_hour": null,
  "note": "円/シミュ日の計器(S4)が出来るまでの代わり。電気代などの 1 時間あたりの円を入れると、夜の壁時計 ÷ シミュ日から出す。空欄なら未計測。"
 },
 "env": {
  "PYTHONIOENCODING": "utf-8",
  "PYTHONPATH": "src"
 },
 "vars": {
  "WSL_DISTRO": null,
  "MODEL": null,
  "VLLM_BIN": null,
  "VLLM_ENV": null,
  "VLLM_ARGS": null,
  "VLLM_PORT": 8000,
  "TMUX_SESSION": "shibuya-vllm",
  "VLLM_LOG": "/tmp/shibuya-vllm.log",
  "E2_ARM_FLAGS": null,
  "E5_PERSONA_ATTR_FLAGS": null,
  "E5_PERSONA_TRAIT_FLAGS": null,
  "E5_PERSONA_STORY_FLAGS": null,
  "E6_ARM_CURRENT_FLAGS": null,
  "E6_ARM_MEMORY_FLAGS": null,
  "E6_ARM_PREDICT_FLAGS": null,
  "E6_ARM_BOTH_FLAGS": null,
  "E7_PERTURB_FLAGS": null,
  "E8_COMMAND": null
 },
 "vars_note": {
  "WSL_DISTRO": "WSL2 の配布の名(wsl -l -v で見る)",
  "MODEL": "vLLM に渡すモデル(Hugging Face の名か WSL の中の置き場)。served-model-name は /v1/models から自動で見つける",
  "VLLM_BIN": "WSL の中の vllm の実行ファイル(venv の bin/vllm。~ から書く)",
  "VLLM_ENV": "vllm の前に置く環境変数(例 CUDA_HOME=… を空白区切り。要らなければ空の文字列)",
  "VLLM_ARGS": "vllm serve の残りの引数(--served-model-name・--max-model-len・--gpu-memory-utilization・量子化など。要らなければ空の文字列)",
  "E2_ARM_FLAGS": "E2 で on にする腕の引数の並び(JSON の配列で入れると 1 つずつ差し込む)。自由意図(--intent-mode の自由の値)は語彙の版 v1/v2 と一緒にしか使えない(cli の検査)=v3 の既定とは別の構成になる",
  "E5_PERSONA_ATTR_FLAGS": "E5 の 3 構成の引数(属性だけ/+性格/+生い立ち)。ペルソナの層(P7)の口が出来てから",
  "E6_ARM_CURRENT_FLAGS": "E6 の 4 腕(現状/記憶だけ/予測だけ/記憶+予測)。R-K の後",
  "E7_PERTURB_FLAGS": "E7 の揺らし(火事・大雨・運休)の引数。計器(4-9)が出来てから",
  "E8_COMMAND": "E8 の試験のコマンド全体(JSON の配列)。判断モデルの候補の重みの取得は許可の範囲で(huggingface.co)"
 },
 "fleet": {
  "endpoints": ["http://127.0.0.1:{{VLLM_PORT}}"],
  "model": "",
  "model_note": "期待する served-model-name。空なら照合しない。入れると健全性の確認で /v1/models の名と照合し、違えば止める",
  "start": {
   "argv": ["wsl.exe", "-d", "{{WSL_DISTRO}}", "--", "bash", "-lc", "tmux new-session -d -s {{TMUX_SESSION}} \"{{VLLM_ENV}} {{VLLM_BIN}} serve {{MODEL}} --port {{VLLM_PORT}} {{VLLM_ARGS}} > {{VLLM_LOG}} 2>&1\""],
   "background": false,
   "timeout_s": 120,
   "note": "既定は tmux で切り離して起こす(コマンドはすぐ返る)。WSL が切り離した過程を残さない場合は background を true にして、vllm serve を前景で回すコマンドに書き換える(night_run が過程を持ち、落とすときに止める)。background:true のときは stop も wsl.exe -d {{WSL_DISTRO}} -- pkill -f 'vllm serve' に替える(tmux の会話が無いため)。起動の前にも stop を 1 回回す(前の夜の残りの掃除・失敗は無視)。R-C の答申で決める"
  },
  "health": {
   "wait_s": 900,
   "poll_s": 10,
   "max_tokens": 16,
   "prompt": "1 行で答えてください。いまは朝ですか夜ですか。"
  },
  "collect_log": {
   "argv": ["wsl.exe", "-d", "{{WSL_DISTRO}}", "--", "bash", "-lc", "tail -n 200 {{VLLM_LOG}}"],
   "timeout_s": 60
  },
  "stop": {
   "argv": ["wsl.exe", "-d", "{{WSL_DISTRO}}", "--", "bash", "-lc", "tmux kill-session -t {{TMUX_SESSION}}"],
   "timeout_s": 120
  }
 },
